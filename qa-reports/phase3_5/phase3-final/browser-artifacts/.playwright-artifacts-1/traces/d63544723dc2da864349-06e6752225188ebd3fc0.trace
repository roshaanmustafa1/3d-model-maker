{"type":"before","callId":"immr@111","startTime":190385.802,"class":"Frame","method":"evaluateExpression","params":{"expression":"() => {\n    const meshes = window.__qaSceneObjects().filter(object => object.isMesh && object.name && object.geometry?.attributes.uv);\n    const sample = meshes.find(object => object.__r3f?.root);\n    const root = sample?.__r3f.root.getState();\n    function hash(values) {\n      let h = 2166136261;\n      for (const v of values) h = Math.imul(h ^ Math.round(v * 1000000), 16777619);\n      return h >>> 0;\n    }\n    return {\n      camera: root?.camera.position.toArray(),\n      memory: root && {\n        ...root.gl.info.memory\n      },\n      heap: performance.memory?.usedJSHeapSize,\n      meshes: meshes.map(mesh => ({\n        name: mesh.name,\n        vertices: mesh.geometry.attributes.position.count,\n        triangles: (mesh.geometry.index?.count || mesh.geometry.attributes.position.count) / 3,\n        attributes: Object.fromEntries(Object.entries(mesh.geometry.attributes).map(([k, v]) => [k, {\n          count: v.count,\n          hash: hash(v.array)\n        }])),\n        groups: mesh.geometry.groups,\n        matrix: mesh.matrixWorld.toArray(),\n        materials: (Array.isArray(mesh.material) ? mesh.material : [mesh.material]).map(material => {\n          const image = material.map?.image;\n          let texture;\n          if (image?.width) {\n            const canvas = document.createElement('canvas');\n            canvas.width = image.width;\n            canvas.height = image.height;\n            const ctx = canvas.getContext('2d');\n            ctx.drawImage(image, 0, 0);\n            const pixels = ctx.getImageData(0, 0, canvas.width, canvas.height).data;\n            texture = {\n              width: image.width,\n              height: image.height,\n              hash: hash(pixels),\n              colorSpace: material.map.colorSpace,\n              flipY: material.map.flipY,\n              center: Array.from(ctx.getImageData(Math.floor(image.width / 2), Math.floor(image.height / 2), 1, 1).data),\n              corner: Array.from(ctx.getImageData(4, 4, 1, 1).data)\n            };\n          }\n          return {\n            color: material.color?.getHexString(),\n            linear: material.color?.toArray(),\n            roughness: material.roughness,\n            metalness: material.metalness,\n            type: material.type,\n            normalMap: !!material.normalMap,\n            texture\n          };\n        })\n      }))\n    };\n  }","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}}}
