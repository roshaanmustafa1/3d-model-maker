{"type":"before","callId":"gxsy@159","startTime":257862.412,"class":"Page","method":"addInitScript","params":{"source":"(function observeReactScenes() {\n  const roots = new Map(),\n    renderers = new Map();\n  window.__qaRoots = roots;\n  window.__REACT_DEVTOOLS_GLOBAL_HOOK__ = {\n    supportsFiber: true,\n    renderers,\n    inject(renderer) {\n      const id = renderers.size + 1;\n      renderers.set(id, renderer);\n      return id;\n    },\n    onCommitFiberRoot(id, root) {\n      roots.set(id, root);\n    },\n    onCommitFiberUnmount() {},\n    onPostCommitFiberRoot() {}\n  };\n  window.__qaSceneObjects = () => {\n    const seen = new Set(),\n      objects = new Set();\n    function visit(fiber) {\n      if (!fiber || seen.has(fiber)) return;\n      seen.add(fiber);\n      const object = fiber.stateNode?.object || fiber.stateNode;\n      if (object?.isObject3D) objects.add(object);\n      visit(fiber.child);\n      visit(fiber.sibling);\n    }\n    roots.forEach(root => visit(root.current));\n    return [...objects];\n  };\n  window.__qaSnapshot = () => {\n    const objects = window.__qaSceneObjects();\n    const state = objects.find(object => object.__r3f?.root)?.__r3f.root.getState();\n    const scene = state?.scene || objects.find(object => object.isScene);\n    const meshes = [];\n    scene?.traverse(object => {\n      if (!object.isMesh || !object.name) return;\n      const materials = Array.isArray(object.material) ? object.material : [object.material];\n      meshes.push({\n        name: object.name,\n        uuid: object.uuid,\n        position: object.position.toArray(),\n        matrixWorld: object.matrixWorld.toArray(),\n        vertices: object.geometry.attributes.position?.count,\n        triangles: (object.geometry.index?.count ?? object.geometry.attributes.position?.count ?? 0) / 3,\n        uv: object.geometry.attributes.uv && Array.from(object.geometry.attributes.uv.array),\n        materials: materials.map(m => ({\n          uuid: m.uuid,\n          name: m.name,\n          type: m.type,\n          color: m.color?.getHexString(),\n          linearColor: m.color?.toArray(),\n          roughness: m.roughness,\n          metalness: m.metalness,\n          opacity: m.opacity,\n          side: m.side,\n          wireframe: m.wireframe,\n          map: m.map && {\n            uuid: m.map.uuid,\n            width: m.map.image?.width,\n            height: m.map.image?.height,\n            colorSpace: m.map.colorSpace\n          },\n          normalMap: m.normalMap && {\n            colorSpace: m.normalMap.colorSpace,\n            width: m.normalMap.image?.width\n          }\n        }))\n      });\n    });\n    return {\n      meshes,\n      renderer: state && {\n        calls: state.gl.info.render.calls,\n        triangles: state.gl.info.render.triangles,\n        memory: {\n          ...state.gl.info.memory\n        }\n      },\n      camera: state?.camera.position.toArray()\n    };\n  };\n})(undefined)"}}
