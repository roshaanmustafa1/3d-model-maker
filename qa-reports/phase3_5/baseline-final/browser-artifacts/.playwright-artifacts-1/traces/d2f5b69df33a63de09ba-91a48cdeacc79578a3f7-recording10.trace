{"type":"before","callId":"nszx@776","startTime":264572.644,"class":"Frame","method":"evaluateExpression","params":{"expression":"() => [...window.__qaAppearanceRecords.values()].map(({\n    mesh,\n    partId\n  }) => {\n    const material = Array.isArray(mesh.material) ? mesh.material[0] : mesh.material;\n    return {\n      name: mesh.name,\n      partId,\n      type: material.type,\n      linear: material.color.toArray(),\n      srgb: material.color.toArray().map(value => Math.round(255 * (value <= .0031308 ? 12.92 * value : 1.055 * value ** (1 / 2.4) - .055))).map(value => value.toString(16).padStart(2, '0')).join(''),\n      roughness: material.roughness,\n      metalness: material.metalness,\n      map: material.map?.image?.width || 0,\n      normalMap: material.normalMap?.image?.width || 0,\n      geometry: Object.fromEntries(Object.entries(mesh.geometry.attributes).map(([key, value]) => [key, Array.from(value.array)]))\n    };\n  })","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}}}
